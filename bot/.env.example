# Nusxa oling: .env.local (lokal) yoki Vercel → Settings → Environment Variables (production).
DATABASE_URL=""            # Supabase (jadval egasi, "postgres"): postgresql://... yoki Host=...;Username=...;Password=...
TELEGRAM_BOT_TOKEN=""      # @BotFather token
TELEGRAM_BOT_USERNAME=""   # ixtiyoriy: bot username (@siz). Bo'sh bo'lsa Telegram getMe'dan olinadi; ilova "Botni ochish" havolasi uchun
# Ko'p foydalanuvchili: har foydalanuvchi YtAuto ilovasi bergan token bilan kiradi (ALLOWED_TELEGRAM_IDS endi ishlatilmaydi).
# Har foydalanuvchi o'z Gemini kalitlarini botning Sozlamalar → Gemini bo'limida kiritadi.
GEMINI_API_KEY=""          # faqat DEMO_MODE=1 da (AI yordamchini sinash uchun)
GEMINI_CHAT_MODEL=""       # ixtiyoriy: AI yordamchi modeli (bo'sh — Sozlamalardagi Gemini modeli)
DB_AUTO_MIGRATE="0"        # 1 — sxema eski bo'lsa bot o'zi migratsiya qiladi. 0 — qo'lda: npm run db:migrate
DEVICE_DB_HOST=""          # ixtiyoriy: desktop ilovalar ulanadigan host (bo'sh — DATABASE_URL dagi host)
DEVICE_DB_PORT=""          # ixtiyoriy: desktop porti (bo'sh — Supabase pooler bo'lsa 5432 session rejimi)
ALLOW_BROWSER_DEV="0"      # 1 — Telegram'siz brauzerda ochish (faqat lokal!)
DEMO_MODE="0"              # 1 — bazasiz namunaviy ma'lumotlar (dizayn ko'rish)
CRON_SECRET=""             # kunlik fon ishi (/api/cron/daily, bot/vercel.json): kanal kontekstini yangilash va mavzu tavsiyalari. Kamida 16 belgi; Vercel o'zi Authorization: Bearer bilan yuboradi
GOOGLE_SITE_VERIFICATION="" # Google Search Console → URL prefix → HTML tag usulidagi content kodi (sayt egaligi, OAuth tekshiruvi uchun)
CONTACT_EMAIL=""           # /privacy, /terms, /about sahifalaridagi aloqa emaili (Google OAuth Branding talab qiladi)
YOUTUBE_CLIENT_ID=""       # umumiy Google OAuth client (Web application): har foydalanuvchi o'z kanalini shu orqali ulaydi.
YOUTUBE_CLIENT_SECRET=""   # Redirect URI: https://<bot>/api/youtube/callback. Secret foydalanuvchilarga berilmaydi.
SUPABASE_URL=""            # shablon va audio fayllari uchun Storage
SUPABASE_SERVICE_ROLE_KEY=""
