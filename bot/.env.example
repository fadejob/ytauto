# Nusxa oling: .env.local (lokal) yoki Vercel → Settings → Environment Variables (production).
DATABASE_URL=""            # Supabase: postgresql://... yoki Host=...;Username=...;Password=...
TELEGRAM_BOT_TOKEN=""      # @BotFather token
# AI yordamchi Gemini bilan ishlaydi: kalitlar botning Sozlamalar → Gemini bo'limidan olinadi (bir nechta bo'lishi mumkin).
GEMINI_API_KEY=""          # ixtiyoriy: botda kalit bo'lmasa ishlatiladi (aistudio.google.com)
GEMINI_CHAT_MODEL=""       # ixtiyoriy: AI yordamchi modeli (bo'sh — Sozlamalardagi Gemini modeli)
ALLOWED_TELEGRAM_IDS=""    # ruxsat etilgan Telegram ID'lar, vergul bilan
ALLOW_BROWSER_DEV="0"      # 1 — Telegram'siz brauzerda ochish (faqat lokal!)
DEMO_MODE="0"              # 1 — bazasiz namunaviy ma'lumotlar (dizayn ko'rish)
