<UserControl x:Class="YtAuto.Desktop.Views.NewTopicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Yangi mavzu" Style="{StaticResource H1}"/>
                <TextBlock Text="Mavzu" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Qo'shimcha izoh (ixtiyoriy)" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Til" Style="{StaticResource Label}"/>
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" IsEditable="True" Text="{Binding Language}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Video formati" Style="{StaticResource Label}"/>
                        <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Ovoz profili" Style="{StaticResource Label}"/>
                        <ComboBox ItemsSource="{Binding VoiceProfiles}" SelectedItem="{Binding VoiceProfile}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Shablon" Style="{StaticResource Label}"/>
                <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding Template}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Border Width="80" Height="45" Background="#E5E7EB" CornerRadius="3" ClipToBounds="True" Margin="0,0,10,0">
                                    <Image Source="{Binding Thumbnail, Converter={StaticResource Thumb}, ConverterParameter=120}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding KindText}" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                           Text="Davomiylik kiritilmaydi: ssenariy mavzuga qarab yoziladi, video uzunligi tayyor ovoz va subtitrga qarab belgilanadi. Shablonlar Sozlamalar → 'OpenFilm va shablonlar' bo'limida yuklanadi."/>
                <TextBlock Text="YouTube chiqish sanasi va soati" Style="{StaticResource Label}"/>
                <StackPanel Orientation="Horizontal">
                    <DatePicker SelectedDate="{Binding PublishDate}" Width="160"/>
                    <TextBox Text="{Binding PublishTime}" Width="70" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Navbatga qo'shish" Style="{StaticResource Primary}" Command="{Binding SaveCommand}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0"
                           Text="Mavzu navbatga qo'shiladi. Video tayyorlash faqat worker jadval bo'yicha (yoki 'Jadval va worker' sahifasidagi 'Hozir ishga tushirish') boshlanganda bajariladi; har ishga tushishda bitta mavzu."/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
