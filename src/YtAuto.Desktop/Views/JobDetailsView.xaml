<UserControl x:Class="YtAuto.Desktop.Views.JobDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Unloaded="OnUnloaded">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="← Videolarga qaytish" Command="{Binding BackCommand}" DockPanel.Dock="Left"/>
            <TextBlock Text="{Binding Job.DisplayTitle}" Style="{StaticResource H1}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Job.Topic, StringFormat='Mavzu: {0}'}" Style="{StaticResource Muted}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Background="{Binding Job.Status, Converter={StaticResource StatusBrush}}" CornerRadius="10" Padding="8,2">
                            <TextBlock Text="{Binding StatusText}" Foreground="White"/>
                        </Border>
                        <TextBlock Text="{Binding PublishText, StringFormat='   Chiqish: {0}'}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Job.AttentionReason}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding Job.AttentionReason, Converter={StaticResource NullCollapsed}}"/>
                    <TextBlock Text="{Binding Job.LastErrorMessage, StringFormat='Oxirgi xato: {0}'}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding Job.LastErrorMessage, Converter={StaticResource NullCollapsed}}"/>

                    <Border Background="Black" Height="292" Margin="0,12,0,0" CornerRadius="4">
                        <Grid>
                            <Image Source="{Binding Job.ThumbnailPath, Converter={StaticResource Thumb}, ConverterParameter=520}" Stretch="Uniform"/>
                            <MediaElement x:Name="Player" Source="{Binding VideoSource}" LoadedBehavior="Play" UnloadedBehavior="Close" Stretch="Uniform"/>
                            <MediaElement x:Name="AudioPlayer" Source="{Binding AudioSource}" LoadedBehavior="Play" UnloadedBehavior="Close" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="▶ Videoni ko'rish" Command="{Binding PlayVideoCommand}"/>
                        <Button Content="♪ Ovozni tinglash" Command="{Binding PlayAudioCommand}"/>
                        <Button Content="■ To'xtatish" Command="{Binding StopMediaCommand}"/>
                        <Button Content="YouTube'da ochish" Command="{Binding OpenYouTubeCommand}" Visibility="{Binding Job.YouTubeVideoId, Converter={StaticResource NullCollapsed}}"/>
                    </StackPanel>

                    <TextBlock Text="Amallar" Style="{StaticResource H2}"/>
                    <WrapPanel>
                        <Button Content="Qayta urinish" Command="{Binding RetryCommand}" IsEnabled="{Binding CanRetry}" Margin="0,0,8,6"/>
                        <Button Content="Joriy sozlamalar bilan qayta" Command="{Binding RetryWithCurrentSettingsCommand}" IsEnabled="{Binding CanRetry}" Margin="0,0,8,6"/>
                        <Button Content="Bekor qilish" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}" Margin="0,0,8,6"/>
                        <Button Content="YouTube holatini tekshirish" Command="{Binding RefreshYouTubeCommand}" Margin="0,0,8,6"/>
                        <Button Content="Yangi upload (sessiya yo'qolgan)" Command="{Binding ForceNewUploadCommand}" Visibility="{Binding CanForceNewUpload, Converter={StaticResource BoolVis}}" Margin="0,0,8,6"/>
                        <Button Content="Mavzuni o'chirish" Command="{Binding DeleteCommand}" Foreground="{StaticResource Danger}" Margin="0,0,8,6"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <TextBlock Text="Mavzu va sozlamalarni tahrirlash" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding EditNote}" Style="{StaticResource Muted}" Visibility="{Binding EditNote, Converter={StaticResource NullCollapsed}}"/>
                    <Border Style="{StaticResource Card}" Padding="12" Visibility="{Binding CanEdit, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="Mavzu" Style="{StaticResource Label}" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding EditTopic, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Qo'shimcha izoh" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding EditNotes}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Til" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Languages}" IsEditable="True" Text="{Binding EditLanguage}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Format" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding EditFormat}"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="Ovoz profili" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding VoiceProfiles}" SelectedItem="{Binding EditVoice}"/></StackPanel>
                            </Grid>
                            <TextBlock Text="Shablon" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding EditTemplate}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <Border Width="64" Height="36" Background="#E5E7EB" CornerRadius="3" ClipToBounds="True" Margin="0,0,8,0">
                                                <Image Source="{Binding Thumbnail, Converter={StaticResource Thumb}, ConverterParameter=100}" Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="YouTube chiqish sanasi va soati" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <DatePicker SelectedDate="{Binding NewPublishDate}" Width="150"/>
                                <TextBox Text="{Binding NewPublishTime}" Width="60" Margin="6,0"/>
                            </StackPanel>
                            <Button Content="O'zgarishlarni saqlash" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding SaveEditCommand}"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                       Text="Mavzu, izoh yoki til o'zgarsa, ssenariydan boshlab qayta tayyorlanadi; shablon yoki format o'zgarsa - montajdan; ovoz o'zgarsa - ovozdan. Faqat vaqt o'zgarsa video qayta yaratilmaydi. Worker shu vazifa ustida ishlayotgan paytda saqlab bo'lmaydi."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Fayllar" Style="{StaticResource H2}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="Video" Style="{StaticResource Muted}"/><TextBox Grid.Column="1" IsReadOnly="True" Text="{Binding Job.VideoArchivePath, Mode=OneWay}" BorderThickness="0" Background="Transparent"/>
                        <Button Grid.Column="2" Content="Papka" Padding="6,1" Margin="0" Command="{Binding OpenVideoFolderCommand}"/>
                        <TextBlock Grid.Row="1" Text="Ovoz" Style="{StaticResource Muted}"/><TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" Text="{Binding Job.AudioArchivePath, Mode=OneWay}" BorderThickness="0" Background="Transparent"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="Papka" Padding="6,1" Margin="0" Command="{Binding OpenAudioFolderCommand}"/>
                        <TextBlock Grid.Row="2" Text="Subtitr" Style="{StaticResource Muted}"/><TextBox Grid.Row="2" Grid.Column="1" IsReadOnly="True" Text="{Binding Job.SubtitleArchivePath, Mode=OneWay}" BorderThickness="0" Background="Transparent"/>
                        <TextBlock Grid.Row="3" Text="Ish papka" Style="{StaticResource Muted}"/><TextBox Grid.Row="3" Grid.Column="1" IsReadOnly="True" Text="{Binding Job.WorkDir, Mode=OneWay}" BorderThickness="0" Background="Transparent"/>
                        <Button Grid.Row="3" Grid.Column="2" Content="Papka" Padding="6,1" Margin="0" Command="{Binding OpenWorkDirCommand}"/>
                        <TextBlock Grid.Row="4" Text="Loglar" Style="{StaticResource Muted}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="records (job.log, promptlar, QA hisobot)" Style="{StaticResource Muted}"/>
                        <Button Grid.Row="4" Grid.Column="2" Content="Papka" Padding="6,1" Margin="0" Command="{Binding OpenRecordsCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding Job.YouTubeUrl, StringFormat='YouTube: {0}'}" Margin="0,6,0,0" Visibility="{Binding Job.YouTubeVideoId, Converter={StaticResource NullCollapsed}}"/>
                </StackPanel>
            </ScrollViewer>

            <TabControl Grid.Column="2">
                <TabItem Header="Bosqichlar">
                    <DataGrid ItemsSource="{Binding Stages}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bosqich" Binding="{Binding Stage}" Width="80"/>
                            <DataGridTextColumn Header="Holat" Binding="{Binding State}" Width="70"/>
                            <DataGridTextColumn Header="Boshlandi" Binding="{Binding Started}" Width="110"/>
                            <DataGridTextColumn Header="Vaqt" Binding="{Binding Duration}" Width="60"/>
                            <DataGridTextColumn Header="Urin." Binding="{Binding Attempts}" Width="40"/>
                            <DataGridTextColumn Header="Xato / o'lchovlar" Width="*" Binding="{Binding Error}">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding Metrics}"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate><TextBlock Text="{Binding Metrics}" Style="{StaticResource Muted}" Margin="8,2"/></DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Title va tavsif">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock Text="Title" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Job.Title, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
                            <TextBlock Text="Tavsif" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Job.Description, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="200"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Subtitr">
                    <TextBox Text="{Binding Subtitles, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </TabItem>
                <TabItem Header="Log">
                    <DockPanel>
                        <Button DockPanel.Dock="Top" Content="Yangilash" HorizontalAlignment="Left" Command="{Binding LoadCommand}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding LogTail, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</UserControl>
