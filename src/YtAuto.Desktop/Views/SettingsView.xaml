<UserControl x:Class="YtAuto.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YtAuto.Desktop.Ui">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Sozlamalar" Style="{StaticResource H1}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Saqlash" Style="{StaticResource Primary}" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource Accent}"/>
        <TabControl Padding="12">
            <TabItem Header="Online baza">
                <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Text="Online baza (Supabase PostgreSQL)" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding StoreInfo}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Online bazada: mavzular (yaratish, tahrirlash, o'chirish), ularning holati, bosqichlari va loglari, worker ishga tushishlari hamda Gemini va Claude promptlari — barcha kompyuterlar uchun umumiy. Kompyuterga xos sozlamalar (dastur yo'llari, papkalar, ovoz katalogi) va sirlar (API kalitlar, tokenlar) shu kompyuterda qoladi. Video/ovoz fayllari arxiv papkasida."/>
                    <TextBlock Text="Ulanish satri (parol bilan; Windows DPAPI bilan shifrlab saqlanadi)" Style="{StaticResource Label}" Margin="0,14,0,3"/>
                    <PasswordBox x:Name="PgConnection" PasswordChanged="PgConnection_Changed"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Format: Host=aws-0-REGION.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.LOYIHA;Password=...;SSL Mode=Require. Supabase'ning db.*.supabase.co manzili faqat IPv6 orqali ishlaydi — IPv4 tarmoqda pooler manzilidan foydalaning."/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Tekshirish va saqlash" Style="{StaticResource Primary}" Command="{Binding SaveConnectionCommand}"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Umumiy">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="Yangi mavzu uchun standart qiymatlar" Style="{StaticResource H2}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Til" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Languages}" IsEditable="True" Text="{Binding S.Defaults.Language}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Format" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding S.Defaults.Format}"/></StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Video davomiyligi oldindan berilmaydi: ssenariy mavzuga qarab yoziladi, video uzunligi tayyor ovoz va subtitrga qarab belgilanadi."/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Standart shablon" Style="{StaticResource Label}"/><TextBox Text="{Binding S.Defaults.Template}" IsReadOnly="True" ToolTip="'OpenFilm va shablonlar' bo'limida tanlanadi"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Standart ovoz profili" Style="{StaticResource Label}"/><TextBox Text="{Binding S.Defaults.VoiceProfile}" IsReadOnly="True" ToolTip="'Ovoz' bo'limida tanlanadi"/></StackPanel>
                        </Grid>
                        <TextBlock Text="Papkalar" Style="{StaticResource H2}"/>
                        <TextBlock Text="Video arxiv papkasi (doimiy)" Style="{StaticResource Label}"/><TextBox Text="{Binding S.Paths.VideoArchiveDir}"/>
                        <TextBlock Text="Ovoz arxiv papkasi (doimiy)" Style="{StaticResource Label}"/><TextBox Text="{Binding S.Paths.AudioArchiveDir}"/>
                        <TextBlock Text="Shablonlar papkasi (yuklangan shablon videolari/loyihalari shu yerda lokal saqlanadi)" Style="{StaticResource Label}"/><TextBox Text="{Binding S.Paths.TemplatesDir}"/>
                        <TextBlock Text="Vaqtinchalik ish papkasi (jobs; muvaffaqiyatli natijadan keyin tozalanadi)" Style="{StaticResource Label}"/><TextBox Text="{Binding S.Paths.WorkDir}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Arxiv manzili o'zgarsa, eski fayllar ko'chirilmaydi: eski vazifalar o'z manzillarini saqlaydi."/>
                        <TextBlock Text="Limitlar" Style="{StaticResource H2}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Ishga tushish urinishlari" Style="{StaticResource Label}"/><TextBox Text="{Binding S.Limits.MaxRunAttempts}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="QA tuzatish sikllari" Style="{StaticResource Label}"/><TextBox Text="{Binding S.Limits.MaxQaFixCycles}"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Min. bo'sh disk (GB)" Style="{StaticResource Label}"/><TextBox Text="{Binding S.Limits.MinFreeDiskGb}"/></StackPanel>
                            <StackPanel Grid.Column="6"><TextBlock Text="TTS uchun min. bo'sh RAM (GB)" Style="{StaticResource Label}"/><TextBox Text="{Binding S.Limits.MinFreeRamGbForTts}"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Gemini (ssenariy)">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="API kaliti" Style="{StaticResource Label}"/>
                        <StackPanel Orientation="Horizontal">
                            <PasswordBox x:Name="GeminiKey" Width="360" PasswordChanged="GeminiKey_Changed"/>
                            <TextBlock Text="{Binding GeminiKeyState}" Style="{StaticResource Muted}" Margin="10,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Model" Style="{StaticResource Label}"/><TextBox Text="{Binding S.Gemini.Model}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Temperature" Style="{StaticResource Label}"/><TextBox Text="{Binding S.Gemini.Temperature}"/></StackPanel>
                            <CheckBox Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,0,4" IsChecked="{Binding S.Gemini.UseSearchGrounding}"
                                      Content="Hozirgi faktlar uchun Google Search bilan fakt varag'i (manbalar API'dan)"/>
                        </Grid>
                        <DockPanel Margin="0,8,0,3">
                            <Button DockPanel.Dock="Right" Content="Promptlarni standartga qaytarish" Command="{Binding ResetPromptsCommand}" Margin="0"/>
                            <TextBlock TextWrapping="Wrap" Text="Ssenariy prompti. Gemini JSON qaytaradi: subtitle_text (ovoz shu matndan yaratiladi va u subtitr bo'ladi) + youtube_title (YouTube'ga chiqarishgacha saqlanadi). Placeholderlar: {topic} {notes} {language} {language_name} {length_rule} {format} {fact_sheet}" Style="{StaticResource Label}"/>
                        </DockPanel>
                    </StackPanel>
                    <TextBox Text="{Binding S.Gemini.ScriptPrompt}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="Claude (montaj)">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Claude Code (claude.exe) yo'li" Style="{StaticResource Label}"/><TextBox Text="{Binding S.Claude.ExecutablePath}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Model (bo'sh - standart)" Style="{StaticResource Label}"/><TextBox Text="{Binding S.Claude.Model}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Timeout (daqiqa)" Style="{StaticResource Label}"/><TextBox Text="{Binding S.Claude.TimeoutMinutes}"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Maks. byudjet USD (0 - cheklovsiz)" Style="{StaticResource Label}"/><TextBox Text="{Binding S.Claude.MaxBudgetUsd}"/></StackPanel>
                        </Grid>
                        <TextBlock TextWrapping="Wrap" Text="Claude prompti. Claude'ga shu prompt + subtitr (matn va vaqtlari) + ovoz + shablon (bo'lsa) yuboriladi; worker tekshiradigan texnik talablar avtomatik qo'shiladi." Style="{StaticResource Label}"/>
                    </StackPanel>
                    <TextBox Text="{Binding S.Claude.MontagePrompt}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="Ovoz (VoiceStudio)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Kompyuterdagi ovoz modellari" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CatalogInfo}" Style="{StaticResource Muted}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                            <Button Content="Kompyuterdagi modellarni o'qish" Style="{StaticResource Primary}" Command="{Binding RefreshCatalogCommand}"
                                    IsEnabled="{Binding Busy, Converter={x:Static local:InverseBool.Instance}}"/>
                            <CheckBox Content="Ishlatib bo'lmaydiganlarini ham ko'rsatish" IsChecked="{Binding ShowAllEngines}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <ListBox ItemsSource="{Binding Engines}" SelectedItem="{Binding SelectedEngine}" Height="260" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Id, StringFormat='   ({0})'}" Style="{StaticResource Muted}"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Muted}">
                                                <Run Text="Modellar: "/><Run Text="{Binding InstalledModels.Count, Mode=OneWay}"/><Run Text=" o'rnatilgan, ovozlar: "/><Run Text="{Binding Voices.Count, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Reason}" Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                                                       Visibility="{Binding Reason, Converter={StaticResource NullCollapsed}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ovoz" Style="{StaticResource Label}" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding EngineVoices}" Text="{Binding SelectedVoice, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"
                                          ToolTip="Tayyor ovozlardan tanlang (klonlash dvigatellarida bo'sh qolishi mumkin)"/>
                                <TextBlock Text="Til (ovoz qaysi tilda o'qiydi)" Style="{StaticResource Label}"/>
                                <ComboBox ItemsSource="{Binding Languages}" IsEditable="True" Text="{Binding NewVoiceLanguage}"/>
                                <TextBlock Text="Profil nomi" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding NewVoiceName, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="Profil sifatida qo'shish" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding AddVoiceFromCatalogCommand}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Ovoz profillari (mavzu yaratishda tanlanadi)" Style="{StaticResource H2}"/>
                        <DataGrid ItemsSource="{Binding Voices}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="90">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nomi" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Model (dvigatel)" Binding="{Binding Model}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Ovoz" Binding="{Binding Voice}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Til" Binding="{Binding Language}" Width="60"/>
                                <DataGridTextColumn Header="Tezlik" Binding="{Binding Speed}" Width="60"/>
                                <DataGridTemplateColumn Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Standart" Margin="0,0,4,0" Padding="6,1" Command="{Binding DataContext.SetDefaultVoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                        <Button Content="O'chirish" Margin="0" Padding="6,1" Command="{Binding DataContext.RemoveVoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding S.Defaults.VoiceProfile, StringFormat='Standart ovoz: {0}'}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>

                        <Expander Header="VoiceStudio ulanishi (kengaytirilgan)" Margin="0,14,0,0">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="VoiceStudio.exe yo'li" Style="{StaticResource Label}"/><TextBox Text="{Binding S.VoiceStudio.ExePath}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="160"/><ColumnDefinition Width="12"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Lokal API manzili" Style="{StaticResource Label}"/><TextBox Text="{Binding S.VoiceStudio.BaseUrl}"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Ishga tushish kutish (s)" Style="{StaticResource Label}"/><TextBox Text="{Binding S.VoiceStudio.StartupTimeoutSec}"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="TTS bo'lagi (belgi)" Style="{StaticResource Label}"/><TextBox Text="{Binding S.VoiceStudio.ChunkChars}"/></StackPanel>
                                </Grid>
                                <TextBlock Text="Alignment uchun Python (VoiceStudio muhiti)" Style="{StaticResource Label}"/><TextBox Text="{Binding S.VoiceStudio.PythonPath}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="HF model keshi" Style="{StaticResource Label}"/><TextBox Text="{Binding S.VoiceStudio.HfCacheDir}"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Whisper modeli (subtitr vaqtlari)" Style="{StaticResource Label}"/><TextBox Text="{Binding S.VoiceStudio.WhisperModel}"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="OpenFilm va shablonlar">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Shablonlar" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource Muted}" Text="Shablon videosini yoki OpenFilm loyiha papkasini yuklang: u ilovaning shablonlar papkasiga nusxalanib, shu kompyuterda saqlanadi. Mavzu yaratishda shablonlardan biri tanlanadi va video tayyorlanayotganda o'sha shablon uslubi ishlatiladi. Asl fayl o'zgartirilmaydi."/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                            <Button Content="Video shablon yuklash" Style="{StaticResource Primary}" Command="{Binding ImportTemplateVideoCommand}"
                                    IsEnabled="{Binding Busy, Converter={x:Static local:InverseBool.Instance}}"/>
                            <Button Content="OpenFilm loyiha papkasini yuklash" Command="{Binding ImportTemplateFolderCommand}"
                                    IsEnabled="{Binding Busy, Converter={x:Static local:InverseBool.Instance}}"/>
                            <TextBlock Text="{Binding S.Defaults.Template, StringFormat='Standart: {0}'}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <Expander DockPanel.Dock="Bottom" Header="OpenFilm render sozlamalari (kengaytirilgan)" Margin="0,10,0,0">
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="OpenFilm.exe yo'li (bundled CLI va ffmpeg shu yerdan olinadi)" Style="{StaticResource Label}"/><TextBox Text="{Binding S.OpenFilm.ExePath}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Parallel renderer (8 GB RAM: 1)" Style="{StaticResource Label}"/><TextBox Text="{Binding S.OpenFilm.RenderWorkers}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="FPS" Style="{StaticResource Label}"/><TextBox Text="{Binding S.OpenFilm.Fps}"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="Loudness (LUFS)" Style="{StaticResource Label}"/><TextBox Text="{Binding S.OpenFilm.LoudnessLufs}"/></StackPanel>
                                <StackPanel Grid.Column="6"><TextBlock Text="Render timeout (daq)" Style="{StaticResource Label}"/><TextBox Text="{Binding S.OpenFilm.RenderTimeoutMinutes}"/></StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox Content="Subtitrlarni videoga kuydirish (--subtitles)" IsChecked="{Binding S.OpenFilm.BurnSubtitles}" Margin="0,0,20,0"/>
                                <CheckBox Content="Renderdan keyin openfilm look --full" IsChecked="{Binding S.OpenFilm.LookFullAfterRender}"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <ListBox ItemsSource="{Binding Templates}" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="142" Height="80" Background="#E5E7EB" CornerRadius="4" ClipToBounds="True">
                                        <Image Source="{Binding Thumbnail, Converter={StaticResource Thumb}, ConverterParameter=200}" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Kind}" Style="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Notes}" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Standart qilish" Padding="6,2" Command="{Binding DataContext.SetDefaultTemplateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                        <Button Content="O'chirish" Padding="6,2" Command="{Binding DataContext.RemoveTemplateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <TabItem Header="YouTube">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Kanal" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Kanalni ulash" Style="{StaticResource Primary}" Command="{Binding ConnectYouTubeCommand}"/>
                            <Button Content="Uzish" Command="{Binding DisconnectYouTubeCommand}"/>
                            <TextBlock Text="{Binding YouTubeState}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Google ilovasi 'Testing' rejimida: Google ruxsatni 7 kunda bekor qiladi. Shunda vazifa 'E'tibor kerak' bo'ladi — bu yerda 'Kanalni ulash'ni qayta bosing."/>
                        <Expander Header="OAuth client (Google Cloud)" Margin="0,6,0,0">
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="OAuth Client ID" Style="{StaticResource Label}"/><TextBox Text="{Binding S.YouTube.ClientId}"/>
                                <TextBlock Text="OAuth Client Secret (bo'sh qoldirilsa saqlangani o'zgarmaydi)" Style="{StaticResource Label}"/>
                                <PasswordBox x:Name="ClientSecret" Width="360" HorizontalAlignment="Left" PasswordChanged="ClientSecret_Changed"/>
                            </StackPanel>
                        </Expander>

                        <TextBlock Text="Chiqish vaqti" Style="{StaticResource H2}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="12"/><ColumnDefinition Width="220"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Standart public soati (HH:mm)" Style="{StaticResource Label}"/><TextBox Text="{Binding S.YouTube.PublishTime}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Vaqt zonasi" Style="{StaticResource Label}"/><TextBox Text="{Binding S.YouTube.TimeZoneId}"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Public'dan kamida necha daqiqa oldin yuklansin" Style="{StaticResource Label}"/><TextBox Text="{Binding S.YouTube.MinLeadMinutes}" Width="80" HorizontalAlignment="Left"/></StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Har video avval 'Private' yuklanadi va YouTube uni tanlangan vaqtda o'zi 'Public' qiladi (publishAt). Video tayyor bo'lganda vaqt o'tib ketgan bo'lsa, chiqish vaqti avtomatik 'hozir + 35 daqiqa' ga suriladi."/>
                        <CheckBox Content="Obunachilarga yangi video haqida bildirishnoma yuborilsin (notifySubscribers)" IsChecked="{Binding S.YouTube.NotifySubscribers}" Margin="0,8,0,0"/>

                        <TextBlock Text="Video ma'lumotlari" Style="{StaticResource H2}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Kategoriya" Style="{StaticResource Label}"/>
                                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Title"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Mamlakat kodi" Style="{StaticResource Label}"/>
                                <TextBox Text="{Binding S.YouTube.RegionCode}" ToolTip="Kategoriyalar ro'yxati mamlakatga qarab farq qiladi (masalan UZ, US)"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Kategoriyalarni YouTube'dan olish" Command="{Binding RefreshCategoriesCommand}"/>
                            <TextBlock Text="{Binding CategoryInfo}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Qo'shimcha teglar (vergul bilan; Gemini yozgan teglarga qo'shiladi, jami 30 tagacha)" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding S.YouTube.DefaultTags}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Sarlavha, tavsif va teglar har video uchun Gemini tomonidan yoziladi. Video tili va ovoz tili (defaultLanguage / defaultAudioLanguage) mavzuda tanlangan tilga avtomatik qo'yiladi."/>

                        <TextBlock Text="Auditoriya: bolalar uchunmi?" Style="{StaticResource H2}"/>
                        <Border Style="{StaticResource Card}" Padding="12">
                            <StackPanel>
                                <RadioButton GroupName="kids" IsChecked="{Binding NotForKids}" FontWeight="SemiBold" Content="Yo'q, bu video bolalar uchun mo'ljallanmagan"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="20,2,0,8" Text="Umumiy auditoriya uchun ta'limiy/tushuntiruvchi videolar odatda shu toifaga kiradi. Izohlar, bildirishnomalar, shaxsiylashtirilgan reklama va boshqa funksiyalar odatdagidek ishlaydi."/>
                                <RadioButton GroupName="kids" IsChecked="{Binding ForKids}" FontWeight="SemiBold" Content="Ha, bu video bolalar uchun mo'ljallangan (selfDeclaredMadeForKids)"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="20,2,0,0" Text="Asosiy tomoshabin bolalar bo'lsa (bolalar qahramonlari, o'yinchoqlar, bolalarga qaratilgan til va uslub) tanlanadi. Bu AQSh COPPA qonuni va YouTube qoidalari talabi. Bunday videolarda izohlar o'chiriladi, obunachilarga bildirishnoma va shaxsiylashtirilgan reklama bo'lmaydi, mini-pleer va 'Keyinroq ko'rish' kabi funksiyalar cheklanadi. Noto'g'ri belgilash YouTube tomonidan jarimaga yoki kanalga choralarga olib kelishi mumkin. YouTube o'zi ham belgini o'zgartirishi mumkin."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="AI yordamida yaratilgan yoki o'zgartirilgan kontent" Style="{StaticResource H2}"/>
                        <Border Style="{StaticResource Card}" Padding="12">
                            <StackPanel>
                                <RadioButton GroupName="ai" IsChecked="{Binding AiYes}" FontWeight="SemiBold" Content="Ha, belgilansin (containsSyntheticMedia = true)"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="20,2,0,8" Text="Videoda haqiqiyga o'xshaydigan, lekin sun'iy yaratilgan narsa bo'lsa belgilash talab qilinadi: haqiqiy odamni u aytmagan gapni aytayotgandek ko'rsatish (masalan, tanish odam ovozini klonlash), haqiqiy voqea yoki joyni o'zgartirish, yoki haqiqiy ko'rinadigan, lekin bo'lmagan sahna. YouTube video tavsifida (ba'zan pleerda) 'Altered or synthetic content' yorlig'ini ko'rsatadi. Bu tomosha yoki monetizatsiyani o'z-o'zidan cheklamaydi."/>
                                <RadioButton GroupName="ai" IsChecked="{Binding AiNo}" FontWeight="SemiBold" Content="Yo'q, belgilanmasin"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="20,2,0,0" Text="Aniq real bo'lmagan kontent (animatsiya, diagramma, matn animatsiyasi), shuningdek AI faqat ssenariy yozish, subtitr yoki montajda yordam bergan holatlar uchun belgilash shart emas. Bu ilova videolari - sun'iy ovozli diktor va chizilgan tushuntiruvchi animatsiyalar; aniq odam ovozi klonlanmasa, odatda 'Yo'q' yetarli. Ikkilansangiz 'Ha' xavfsizroq."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Ko'rinish va huquqlar" Style="{StaticResource H2}"/>
                        <TextBlock Text="Litsenziya" Style="{StaticResource Label}"/>
                        <ComboBox ItemsSource="{Binding Licenses}" SelectedItem="{Binding SelectedLicense}" DisplayMemberPath="Title" Width="360" HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Standart YouTube - boshqalar videongizdan ruxsatsiz foydalana olmaydi. Creative Commons (CC BY) - boshqalar muallifni ko'rsatgan holda videoni o'z ishlarida qayta ishlatishi mumkin."/>
                        <CheckBox Content="Videoni boshqa saytlarga joylashtirishga ruxsat (embeddable)" IsChecked="{Binding S.YouTube.Embeddable}" Margin="0,10,0,0"/>
                        <CheckBox Content="Video sahifasida kengaytirilgan statistikani hamma ko'rsin (publicStatsViewable)" IsChecked="{Binding S.YouTube.PublicStatsViewable}" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="20,2,0,0" Text="O'chirilsa ham ko'rishlar soni va layklar ko'rinadi; faqat qo'shimcha statistikalar yashiriladi."/>
                        <CheckBox Content="Yozib olingan sana sifatida video tayyorlangan kun ko'rsatilsin (recordingDate)" IsChecked="{Binding S.YouTube.SetRecordingDate}" Margin="0,8,0,0"/>
                        <TextBlock Text="Joy tavsifi (ixtiyoriy, masalan: Toshkent, O'zbekiston)" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding S.YouTube.LocationDescription}" Width="360" HorizontalAlignment="Left"/>

                        <TextBlock Text="API orqali sozlab bo'lmaydiganlar" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" Text="Yosh cheklovi, izohlarni moderatsiya qilish, monetizatsiya, yakuniy ekran (end screen), kartochkalar va pleylistga qo'shish YouTube Data API'ning yuklash so'rovi orqali sozlanmaydi (pleylist va subtitr fayli kengroq ruxsat talab qiladi). Ularni YouTube Studio → Sozlamalar → 'Upload defaults' (Yuklash standartlari) bo'limida kanal bo'yicha bir marta sozlang — yangi videolarga avtomatik qo'llanadi."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Integratsiyalarni tekshirish">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Tekshirish" Style="{StaticResource Primary}" Command="{Binding TestIntegrationsCommand}" IsEnabled="{Binding Busy, Converter={x:Static local:InverseBool.Instance}}"/>
                        <CheckBox Content="Claude autentifikatsiyasini ham tekshirish (kichik so'rov yuboriladi)" IsChecked="{Binding DeepClaudeCheck}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Checks}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Natija" Binding="{Binding Level}" Width="80"/>
                            <DataGridTextColumn Header="Integratsiya" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="Izoh" Binding="{Binding Message}" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
