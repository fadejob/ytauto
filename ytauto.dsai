{
  "format": "dsai",
  "version": "1.0",
  "name": "ytauto",
  "modes": {
    "theme": ["light", "dark"]
  },
  "tokens": {
    "bg": {
      "type": "color",
      "value": "#F5F1EA",
      "modes": {
        "theme:dark": "#151311"
      }
    },
    "card": {
      "type": "color",
      "value": "#FFFDF9",
      "modes": {
        "theme:dark": "#211E1A"
      }
    },
    "sunken": {
      "type": "color",
      "value": "#ECE6DC",
      "modes": {
        "theme:dark": "#2B2723"
      }
    },
    "ink": {
      "type": "color",
      "value": "#1F1B16",
      "modes": {
        "theme:dark": "#F3EEE6"
      }
    },
    "muted": {
      "type": "color",
      "value": "#6E665C",
      "modes": {
        "theme:dark": "#A69D91"
      }
    },
    "faint": {
      "type": "color",
      "value": "#A39A8E",
      "modes": {
        "theme:dark": "#6F675E"
      }
    },
    "line": {
      "type": "color",
      "value": "#E3DCD1",
      "modes": {
        "theme:dark": "#34302B"
      }
    },
    "accent": {
      "type": "color",
      "value": "#F0A53A",
      "modes": {
        "theme:dark": "#F4B254"
      }
    },
    "accentSoft": {
      "type": "color",
      "value": "#FBEBD2",
      "modes": {
        "theme:dark": "#3A2C17"
      }
    },
    "onAccent": {
      "type": "color",
      "value": "#1F1B16"
    },
    "ok": {
      "type": "color",
      "value": "#3F6B2A",
      "modes": {
        "theme:dark": "#8DBF6A"
      }
    },
    "okSoft": {
      "type": "color",
      "value": "#E5EAD6",
      "modes": {
        "theme:dark": "#262C1D"
      }
    },
    "bad": {
      "type": "color",
      "value": "#B3261E",
      "modes": {
        "theme:dark": "#F2786F"
      }
    },
    "badSoft": {
      "type": "color",
      "value": "#F7DEDA",
      "modes": {
        "theme:dark": "#3B1D1A"
      }
    },
    "tabbar": {
      "type": "color",
      "value": "#1F1B16",
      "modes": {
        "theme:dark": "#2B2723"
      }
    },
    "onTabbar": {
      "type": "color",
      "value": "#F5F1EA"
    },
    "font.ui": {
      "type": "font",
      "value": "Onest"
    },
    "r.sm": {
      "type": "number",
      "value": 10
    },
    "r.md": {
      "type": "number",
      "value": 14
    },
    "r.lg": {
      "type": "number",
      "value": 20
    },
    "accentInk": {
      "type": "color",
      "value": "#8A5200",
      "modes": {
        "theme:dark": "#F4B254"
      }
    },
    "bgClear": {
      "type": "color",
      "value": "#F5F1EA00",
      "modes": {
        "theme:dark": "#15131100"
      }
    },
    "inverse": {
      "type": "color",
      "value": "#1F1B16",
      "modes": {
        "theme:dark": "#3A3026"
      }
    },
    "onInverse": {
      "type": "color",
      "value": "#F5F1EA",
      "modes": {
        "theme:dark": "#F5F1EA"
      }
    },
    "onInverseMuted": {
      "type": "color",
      "value": "#A39A8E",
      "modes": {
        "theme:dark": "#BDB3A5"
      }
    },
    "onInverseOk": {
      "type": "color",
      "value": "#9CCB78",
      "modes": {
        "theme:dark": "#9CCB78"
      }
    },
    "scrim": {
      "type": "color",
      "value": "#1F1B1666",
      "modes": {
        "theme:dark": "#00000099"
      }
    }
  },
  "styles": {
    "text.focal": {
      "fontFamily": "$font.ui",
      "fontSize": 44,
      "fontWeight": 800,
      "lineHeight": 1,
      "letterSpacing": -1.6,
      "fill": "$ink"
    },
    "text.h1": {
      "fontFamily": "$font.ui",
      "fontSize": 26,
      "fontWeight": 750,
      "letterSpacing": -0.6,
      "fill": "$ink"
    },
    "text.h2": {
      "fontFamily": "$font.ui",
      "fontSize": 17,
      "fontWeight": 700,
      "letterSpacing": -0.2,
      "fill": "$ink"
    },
    "text.body": {
      "fontFamily": "$font.ui",
      "fontSize": 15,
      "lineHeight": 1.4,
      "fill": "$ink"
    },
    "text.sub": {
      "fontFamily": "$font.ui",
      "fontSize": 13,
      "lineHeight": 1.35,
      "fill": "$muted"
    },
    "text.label": {
      "fontFamily": "$font.ui",
      "fontSize": 12,
      "fontWeight": 600,
      "letterSpacing": 0.4,
      "fill": "$muted"
    },
    "text.btn": {
      "fontFamily": "$font.ui",
      "fontSize": 15,
      "fontWeight": 650,
      "fill": "$ink"
    }
  },
  "components": {
    "Button": {
      "description": "Bosilganda shu tugmaning o'zida spinner aylanadi (state=loading), boshqa joy bloklanmaydi",
      "variants": {
        "tone": ["primary", "secondary", "ghost", "danger"],
        "size": ["md", "sm"],
        "state": ["idle", "loading", "disabled"]
      },
      "props": {
        "label": {
          "type": "string",
          "default": "Saqlash",
          "bind": "hcNg8m.text"
        },
        "icon": {
          "type": "string",
          "default": "lucide:plus",
          "bind": "fIs7ba.icon"
        },
        "showIcon": {
          "type": "boolean",
          "default": false,
          "bind": "fIs7ba.visible"
        }
      },
      "rules": [
        {
          "if": {
            "tone": "secondary"
          },
          "set": {
            "Y9LhpT": {
              "fill": "$sunken"
            },
            "hcNg8m": {
              "fill": "$ink"
            },
            "nBG5uR": {
              "fill": "$ink"
            },
            "fIs7ba": {
              "fill": "$ink"
            }
          }
        },
        {
          "if": {
            "tone": "ghost"
          },
          "set": {
            "Y9LhpT": {
              "fill": null
            },
            "hcNg8m": {
              "fill": "$muted"
            },
            "nBG5uR": {
              "fill": "$muted"
            },
            "fIs7ba": {
              "fill": "$muted"
            }
          }
        },
        {
          "if": {
            "tone": "danger"
          },
          "set": {
            "Y9LhpT": {
              "fill": "$badSoft"
            },
            "hcNg8m": {
              "fill": "$bad"
            },
            "nBG5uR": {
              "fill": "$bad"
            },
            "fIs7ba": {
              "fill": "$bad"
            }
          }
        },
        {
          "if": {
            "size": "sm"
          },
          "set": {
            "Y9LhpT": {
              "height": 36,
              "padding": [0, 12],
              "radius": "$r.sm"
            },
            "hcNg8m": {
              "fontSize": 13
            },
            "nBG5uR": {
              "width": 15,
              "height": 15
            },
            "fIs7ba": {
              "width": 15,
              "height": 15
            }
          }
        },
        {
          "if": {
            "state": "loading"
          },
          "set": {
            "nBG5uR": {
              "visible": true
            },
            "fIs7ba": {
              "visible": false
            },
            "hcNg8m": {
              "opacity": 0.7
            }
          }
        },
        {
          "if": {
            "state": "disabled"
          },
          "set": {
            "Y9LhpT": {
              "fill": "$sunken"
            },
            "hcNg8m": {
              "fill": "$muted"
            },
            "fIs7ba": {
              "fill": "$muted"
            },
            "nBG5uR": {
              "visible": false
            }
          }
        }
      ],
      "root": {
        "type": "frame",
        "id": "Y9LhpT",
        "name": "Button",
        "height": 44,
        "layout": "row",
        "gap": 8,
        "padding": [0, 16],
        "justify": "center",
        "align": "center",
        "fill": "$accent",
        "radius": "$r.md",
        "children": [
          {
            "type": "icon",
            "id": "nBG5uR",
            "name": "Spinner",
            "width": 18,
            "height": 18,
            "icon": "lucide:loader-circle",
            "fill": "$onAccent",
            "visible": false
          },
          {
            "type": "icon",
            "id": "fIs7ba",
            "name": "Lead icon",
            "width": 18,
            "height": 18,
            "icon": "lucide:plus",
            "fill": "$onAccent",
            "visible": false
          },
          {
            "type": "text",
            "id": "hcNg8m",
            "name": "Label",
            "text": "Saqlash",
            "style": "text.btn",
            "fill": "$onAccent"
          }
        ]
      }
    },
    "Status": {
      "variants": {
        "tone": ["neutral", "accent", "ok", "bad"]
      },
      "props": {
        "text": {
          "type": "string",
          "default": "Navbatda",
          "bind": "k28gwk.text"
        }
      },
      "rules": [
        {
          "if": {
            "tone": "accent"
          },
          "set": {
            "5hKAAI": {
              "fill": "$accentSoft"
            },
            "Lbo4yG": {
              "fill": "$accent"
            },
            "k28gwk": {
              "fill": "$accentInk"
            }
          }
        },
        {
          "if": {
            "tone": "ok"
          },
          "set": {
            "5hKAAI": {
              "fill": "$okSoft"
            },
            "Lbo4yG": {
              "fill": "$ok"
            },
            "k28gwk": {
              "fill": "$ok"
            }
          }
        },
        {
          "if": {
            "tone": "bad"
          },
          "set": {
            "5hKAAI": {
              "fill": "$badSoft"
            },
            "Lbo4yG": {
              "fill": "$bad"
            },
            "k28gwk": {
              "fill": "$bad"
            }
          }
        }
      ],
      "root": {
        "type": "frame",
        "id": "5hKAAI",
        "name": "Status",
        "layout": "row",
        "gap": 6,
        "padding": [4, 10],
        "align": "center",
        "fill": "$sunken",
        "radius": 999,
        "children": [
          {
            "type": "ellipse",
            "id": "Lbo4yG",
            "name": "Dot",
            "width": 7,
            "height": 7,
            "fill": "$muted"
          },
          {
            "type": "text",
            "id": "k28gwk",
            "name": "Text",
            "text": "Navbatda",
            "fontFamily": "$font.ui",
            "fontSize": 12,
            "fontWeight": 650,
            "fill": "$muted"
          }
        ]
      }
    },
    "Toggle": {
      "variants": {
        "on": ["true", "false"]
      },
      "rules": [
        {
          "if": {
            "on": "false"
          },
          "set": {
            "Hwxppz": {
              "justify": "start",
              "fill": "$line"
            }
          }
        }
      ],
      "root": {
        "type": "frame",
        "id": "Hwxppz",
        "name": "Toggle",
        "width": 46,
        "height": 28,
        "layout": "row",
        "padding": 4,
        "justify": "end",
        "align": "center",
        "fill": "$ink",
        "radius": 14,
        "children": [
          {
            "type": "ellipse",
            "id": "stFSGK",
            "name": "Knob",
            "width": 20,
            "height": 20,
            "fill": "$card"
          }
        ]
      }
    },
    "Field": {
      "props": {
        "label": {
          "type": "string",
          "default": "MAYDON",
          "bind": "rHdHK2.text"
        },
        "value": {
          "type": "string",
          "default": "Qiymat",
          "bind": "2TmbXG.text"
        },
        "hint": {
          "type": "string",
          "default": "Izoh",
          "bind": "51ZGnt.text"
        },
        "showHint": {
          "type": "boolean",
          "default": false,
          "bind": "51ZGnt.visible"
        }
      },
      "root": {
        "type": "frame",
        "id": "3HhfX7",
        "name": "Field",
        "width": 320,
        "layout": "column",
        "gap": 6,
        "children": [
          {
            "type": "text",
            "id": "rHdHK2",
            "name": "Label",
            "text": "MAYDON",
            "style": "text.label"
          },
          {
            "type": "frame",
            "id": "Fe2dO8",
            "name": "Box",
            "width": "fill",
            "height": 46,
            "layout": "row",
            "gap": 8,
            "padding": [0, 12],
            "align": "center",
            "fill": "$sunken",
            "radius": "$r.sm",
            "children": [
              {
                "type": "text",
                "id": "2TmbXG",
                "name": "Value",
                "width": "fill",
                "text": "Qiymat",
                "maxLines": 1,
                "style": "text.body"
              }
            ]
          },
          {
            "type": "text",
            "id": "51ZGnt",
            "name": "Hint",
            "width": "fill",
            "text": "Izoh",
            "style": "text.sub",
            "visible": false
          }
        ]
      }
    },
    "Settings Row": {
      "props": {
        "title": {
          "type": "string",
          "default": "Kanallar va YouTube",
          "bind": "Jiyybj.text"
        },
        "summary": {
          "type": "string",
          "default": "2 ta kanal",
          "bind": "QNbfoW.text"
        },
        "icon": {
          "type": "string",
          "default": "lucide:tv",
          "bind": "xLjLiq.icon"
        }
      },
      "root": {
        "type": "frame",
        "id": "AvGtFV",
        "name": "Settings Row",
        "width": 358,
        "layout": "row",
        "gap": 12,
        "padding": [12, 16],
        "align": "center",
        "fill": "$card",
        "children": [
          {
            "type": "frame",
            "id": "Xu6KUr",
            "name": "Icon tile",
            "width": 40,
            "height": 40,
            "layout": "row",
            "justify": "center",
            "align": "center",
            "fill": "$sunken",
            "radius": "$r.sm",
            "children": [
              {
                "type": "icon",
                "id": "xLjLiq",
                "name": "Icon",
                "width": 20,
                "height": 20,
                "icon": "lucide:tv",
                "fill": "$ink"
              }
            ]
          },
          {
            "type": "frame",
            "id": "ELhHDT",
            "name": "Texts",
            "width": "fill",
            "layout": "column",
            "gap": 2,
            "children": [
              {
                "type": "text",
                "id": "Jiyybj",
                "name": "Title",
                "width": "fill",
                "text": "Kanallar va YouTube",
                "maxLines": 1,
                "style": "text.h2"
              },
              {
                "type": "text",
                "id": "QNbfoW",
                "name": "Summary",
                "width": "fill",
                "text": "2 ta kanal · faol: Tech Explained",
                "maxLines": 1,
                "style": "text.sub"
              }
            ]
          },
          {
            "type": "icon",
            "id": "0MHwou",
            "name": "Chevron",
            "width": 18,
            "height": 18,
            "icon": "lucide:chevron-right",
            "fill": "$faint"
          }
        ]
      }
    },
    "Tab Bar": {
      "variants": {
        "active": ["videos", "channel", "ai", "activity", "settings"]
      },
      "rules": [
        {
          "if": {
            "active": "videos"
          },
          "set": {
            "1MZHk1": {
              "fill": "$accent"
            },
            "WEQQI8": {
              "fill": "$onAccent"
            },
            "5102rP": {
              "fill": "$onAccent"
            }
          }
        },
        {
          "if": {
            "active": "channel"
          },
          "set": {
            "iqhDR5": {
              "fill": "$accent"
            },
            "t8LNba": {
              "fill": "$onAccent"
            },
            "tNsCYD": {
              "fill": "$onAccent"
            }
          }
        },
        {
          "if": {
            "active": "ai"
          },
          "set": {
            "YcDdHd": {
              "fill": "$accent"
            },
            "LEbTUt": {
              "fill": "$onAccent"
            },
            "uDeYyw": {
              "fill": "$onAccent"
            }
          }
        },
        {
          "if": {
            "active": "activity"
          },
          "set": {
            "fzOj4o": {
              "fill": "$accent"
            },
            "ni6qSD": {
              "fill": "$onAccent"
            },
            "tMkB2w": {
              "fill": "$onAccent"
            }
          }
        },
        {
          "if": {
            "active": "settings"
          },
          "set": {
            "UDUO75": {
              "fill": "$accent"
            },
            "HZkeWm": {
              "fill": "$onAccent"
            },
            "XtSlou": {
              "fill": "$onAccent"
            }
          }
        }
      ],
      "root": {
        "type": "frame",
        "id": "CJjaFE",
        "name": "Tab Bar",
        "width": 358,
        "height": 64,
        "layout": "row",
        "gap": 0,
        "padding": 4,
        "align": "center",
        "fill": "$tabbar",
        "radius": 999,
        "shadow": {
          "x": 0,
          "y": 8,
          "blur": 24,
          "color": "#1F1B1640"
        },
        "children": [
          {
            "type": "frame",
            "id": "1MZHk1",
            "name": "videos",
            "width": "fill",
            "height": 56,
            "layout": "column",
            "gap": 4,
            "justify": "center",
            "align": "center",
            "radius": 999,
            "children": [
              {
                "type": "icon",
                "id": "WEQQI8",
                "name": "Icon",
                "width": 20,
                "height": 20,
                "icon": "lucide:clapperboard",
                "fill": "$onInverseMuted"
              },
              {
                "type": "text",
                "id": "5102rP",
                "name": "Label",
                "text": "Videolar",
                "fontFamily": "$font.ui",
                "fontSize": 12,
                "fontWeight": 550,
                "letterSpacing": -0.2,
                "fill": "$onInverseMuted"
              }
            ]
          },
          {
            "type": "frame",
            "id": "iqhDR5",
            "name": "channel",
            "width": "fill",
            "height": 56,
            "layout": "column",
            "gap": 4,
            "justify": "center",
            "align": "center",
            "radius": 999,
            "children": [
              {
                "type": "icon",
                "id": "t8LNba",
                "name": "Icon",
                "width": 20,
                "height": 20,
