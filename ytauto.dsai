            "name": "activity",
            "width": "fill",
            "height": 56,
            "layout": "column",
            "gap": 4,
            "justify": "center",
            "align": "center",
            "radius": 999,
            "children": [
              {
                "type": "icon",
                "id": "ni6qSD",
                "name": "Icon",
