<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>YtAuto.Desktop</RootNamespace>
    <AssemblyName>YtAuto</AssemblyName>
    <ApplicationIcon></ApplicationIcon>
    <!-- Yagona exe: oyna ham, oynasiz worker ham shu exe ichida (EntryPoint argumentlarga qarab tanlaydi). -->
    <StartupObject>YtAuto.Desktop.EntryPoint</StartupObject>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\YtAuto.Infrastructure\YtAuto.Infrastructure.csproj" />
    <ProjectReference Include="..\YtAuto.Worker\YtAuto.Worker.csproj" />
  </ItemGroup>
</Project>
