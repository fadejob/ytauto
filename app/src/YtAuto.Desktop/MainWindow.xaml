<Window x:Class="YtAuto.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:YtAuto.Desktop.ViewModels"
        xmlns:v="clr-namespace:YtAuto.Desktop.Views"
        Title="YtAuto" Height="820" Width="1100" MinWidth="900" MinHeight="600"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SetupViewModel}"><v:SetupView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><v:HomeView/></DataTemplate>
    </Window.Resources>
    <ContentControl Content="{Binding Page}" Margin="24,20,24,16"/>
</Window>
