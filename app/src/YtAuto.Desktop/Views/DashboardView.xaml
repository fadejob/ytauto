<UserControl x:Class="YtAuto.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:YtAuto.Desktop.Ui">
    <UserControl.Resources>
        <DataTemplate x:Key="CardTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="160" Height="90" Background="#E5E7EB" CornerRadius="4" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="{Binding Format}" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding Thumbnail, Converter={StaticResource Thumb}, ConverterParameter=192}" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Topic}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Topic, Converter={StaticResource NullCollapsed}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border Background="{Binding Status, Converter={StaticResource StatusBrush}}" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11"/>
                            </Border>
                            <TextBlock Text="{Binding PublishText, StringFormat='  Chiqish: {0}'}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Id, StringFormat='   #{0}'}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding Error, Converter={StaticResource NullCollapsed}}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Tafsilotlar" VerticalAlignment="Center"
                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="CardList" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock Text="Videolar" Style="{StaticResource H1}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="YouTube holatini yangilash" Command="{Binding RefreshYouTubeCommand}"/>
            </StackPanel>
        </DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton Content="Hali chiqmagan" IsChecked="{Binding ShowReleased, Converter={x:Static ui:InverseBool.Instance}}" Margin="0,0,16,0"
/>
            <RadioButton Content="YouTube'da chiqarilgan" IsChecked="{Binding ShowReleased}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <DockPanel Visibility="{Binding ShowReleased, Converter={x:Static ui:InverseBoolVis.Instance}}">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button Content="◀" Command="{Binding PrevUpcomingCommand}"/>
                    <TextBlock Text="{Binding UpcomingPageText}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <Button Content="▶" Command="{Binding NextUpcomingCommand}"/>
                </StackPanel>
                <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Upcoming}" ItemTemplate="{StaticResource CardTemplate}"/>
            </DockPanel>
            <DockPanel Visibility="{Binding ShowReleased, Converter={StaticResource BoolVis}}">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button Content="◀" Command="{Binding PrevReleasedCommand}"/>
                    <TextBlock Text="{Binding ReleasedPageText}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <Button Content="▶" Command="{Binding NextReleasedCommand}"/>
                </StackPanel>
                <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Released}" ItemTemplate="{StaticResource CardTemplate}"/>
            </DockPanel>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
    </Grid>
</UserControl>
