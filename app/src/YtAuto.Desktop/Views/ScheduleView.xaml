<UserControl x:Class="YtAuto.Desktop.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Jadval va worker" Style="{StaticResource H1}"/>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="Boshlanish vaqti (HH:mm)" Style="{StaticResource Label}"/><TextBox Text="{Binding StartTime}" Width="90" HorizontalAlignment="Left"/></StackPanel>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="Vaqt zonasi" Style="{StaticResource Label}"/><TextBox Text="{Binding TimeZone}" Width="180"/></StackPanel>
                    <CheckBox Content="Uyqudan uyg'otish (WakeToRun)" IsChecked="{Binding WakeToRun}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Jadvalni yoqish / yangilash" Style="{StaticResource Primary}" Command="{Binding EnableCommand}"/>
                    <Button Content="Jadvalni o'chirish" Command="{Binding DisableCommand}"/>
                    <Button Content="Hozir ishga tushirish (1 vazifa)" Command="{Binding RunNowCommand}"/>
                    <Button Content="Holatni yangilash" Command="{Binding RefreshStateCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock Text="Task Scheduler" Style="{StaticResource H2}"/>
                <TextBlock Text="{Binding TaskState}" TextWrapping="Wrap" FontFamily="Consolas"/>
                <TextBlock Text="{Binding WorkerPath, StringFormat='Worker: {0}'}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding WakeNote}" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="Oxirgi worker ishga tushishlari" Style="{StaticResource H2}"/>
        <DataGrid ItemsSource="{Binding Runs}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Boshlandi" Binding="{Binding Started}" Width="150"/>
                <DataGridTextColumn Header="Davomiyligi" Binding="{Binding Duration}" Width="90"/>
                <DataGridTextColumn Header="Sabab" Binding="{Binding Trigger}" Width="90"/>
                <DataGridTextColumn Header="Natija" Binding="{Binding Outcome}" Width="150"/>
                <DataGridTextColumn Header="Vazifa" Binding="{Binding Job}" Width="60"/>
                <DataGridTextColumn Header="Izoh" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
