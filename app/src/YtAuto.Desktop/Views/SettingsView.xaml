<UserControl x:Class="YtAuto.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YtAuto.Desktop.Ui">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Sozlamalar" Style="{StaticResource H1}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Saqlash" Style="{StaticResource Primary}" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource Accent}"/>
        <Border DockPanel.Dock="Top" Padding="12" Margin="0,0,0,8" CornerRadius="6" Background="White" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Kerakli dasturlar" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                <DockPanel Margin="0,2">
                    <Button DockPanel.Dock="Right" Content="Yuklab o'rnatish" Command="{Binding InstallOpenFilmCommand}"
                            Visibility="{Binding OpenFilmMissing, Converter={x:Static local:BoolToVis.Instance}}"
                            IsEnabled="{Binding Busy, Converter={x:Static local:InverseBool.Instance}}"/>
                    <TextBlock DockPanel.Dock="Right" Text="✓ O'rnatilgan" Foreground="#15803D" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"
                               Visibility="{Binding OpenFilmMissing, Converter={x:Static local:InverseBoolVis.Instance}}"/>
                    <TextBlock Text="{Binding OpenFilmState}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <DockPanel Margin="0,2">
                    <Button DockPanel.Dock="Right" Content="Yuklab o'rnatish" Command="{Binding InstallVoiceStudioCommand}"
                            Visibility="{Binding VoiceStudioMissing, Converter={x:Static local:BoolToVis.Instance}}"
                            IsEnabled="{Binding Busy, Converter={x:Static local:InverseBool.Instance}}"/>
                    <TextBlock DockPanel.Dock="Right" Text="✓ O'rnatilgan" Foreground="#15803D" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"
                               Visibility="{Binding VoiceStudioMissing, Converter={x:Static local:InverseBoolVis.Instance}}"/>
                    <TextBlock Text="{Binding VoiceStudioState}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <DockPanel Margin="0,2">
                    <Button DockPanel.Dock="Right" Content="Modelni yuklab olish" Command="{Binding InstallWhisperModelCommand}"
                            Visibility="{Binding WhisperMissing, Converter={x:Static local:BoolToVis.Instance}}"
                            IsEnabled="{Binding Busy, Converter={x:Static local:InverseBool.Instance}}"/>
                    <TextBlock DockPanel.Dock="Right" Text="✓ O'rnatilgan" Foreground="#15803D" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"
                               Visibility="{Binding WhisperMissing, Converter={x:Static local:InverseBoolVis.Instance}}"/>
                    <TextBlock Text="{Binding WhisperState}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <DockPanel Margin="0,2">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="O'rnatish (~8 GB)" Command="{Binding InstallTtsVoicesCommand}"
                                Visibility="{Binding TtsMissing, Converter={x:Static local:BoolToVis.Instance}}"
                                IsEnabled="{Binding Busy, Converter={x:Static local:InverseBool.Instance}}"/>
                        <TextBlock Text="✓ O'rnatilgan" Foreground="#15803D" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Visibility="{Binding TtsMissing, Converter={x:Static local:InverseBoolVis.Instance}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TtsState}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <DockPanel Margin="0,2">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="✓ Ulangan" Foreground="#15803D" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Visibility="{Binding YouTubeConnected, Converter={x:Static local:BoolToVis.Instance}}"/>
                        <Button Content="Kanalni ulash" Command="{Binding ConnectYouTubeCommand}"
                                Visibility="{Binding YouTubeConnected, Converter={x:Static local:InverseBoolVis.Instance}}"
                                IsEnabled="{Binding Busy, Converter={x:Static local:InverseBool.Instance}}"/>
                        <Button Content="Uzish" Command="{Binding DisconnectYouTubeCommand}" Margin="6,0,0,0"
                                Visibility="{Binding YouTubeConnected, Converter={x:Static local:BoolToVis.Instance}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding YouTubeState, StringFormat='YouTube kanali: {0} (kalit va video sozlamalari botda)'}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <StackPanel Visibility="{Binding InstallText, Converter={x:Static local:NullToCollapsedConverter.Instance}}" Margin="0,6,0,0">
                    <ProgressBar Height="10" Minimum="0" Maximum="100" Value="{Binding InstallFraction}" IsIndeterminate="{Binding InstallIndeterminate}"/>
                    <TextBlock Text="{Binding InstallText}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border VerticalAlignment="Top" Padding="12" CornerRadius="6" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Visibility="{Binding ClaudeMissing, Converter={x:Static local:BoolToVis.Instance}}">
            <StackPanel>
                <TextBlock Text="Claude Code topilmadi" Style="{StaticResource H2}"/>
                <TextBlock Text="Claude Code (claude.exe) yo'li - avtomatik topilmadi, qo'lda ko'rsating" Style="{StaticResource Label}"/><TextBox Text="{Binding S.Claude.ExecutablePath}"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Model (bo'sh - standart)" Style="{StaticResource Label}"/><TextBox Text="{Binding S.Claude.Model}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Timeout (daqiqa)" Style="{StaticResource Label}"/><TextBox Text="{Binding S.Claude.TimeoutMinutes}"/></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="Maks. byudjet USD (0 - cheklovsiz)" Style="{StaticResource Label}"/><TextBox Text="{Binding S.Claude.MaxBudgetUsd}"/></StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="Montaj prompti Telegram bot (web app) orqali tahrirlanadi va online bazada saqlanadi."/>
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
