<UserControl x:Class="YtAuto.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YtAuto.Desktop.Ui">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="YtAuto" Style="{StaticResource H1}" Margin="0"/>
                <TextBlock Style="{StaticResource Muted}" Text="{Binding DeviceName, StringFormat='Qurilma: {0}'}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Yangilash" Command="{Binding RefreshCommand}"/>
                <Button Content="Kengaytirilgan sozlamalar" Command="{Binding OpenAdvancedCommand}" Margin="0"/>
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Token -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Telegram bot uchun token" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                                   Text="Botni oching — birinchi kirishda token so'raladi. Tokenni kiritgach bot faqat shu hisob ma'lumotlarini ko'radi va boshqaradi. Tokenni boshqalarga bermang."/>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Content="Tokenni nusxalash" Style="{StaticResource Primary}" Command="{Binding CopyTokenCommand}"/>
                                <ToggleButton Content="Ko'rsatish" IsChecked="{Binding TokenVisible}" Padding="12,6" Margin="0,0,8,0"/>
                                <Button Content="Botni ochish" Command="{Binding OpenBotCommand}" Margin="0"/>
                            </StackPanel>
                            <TextBox Text="{Binding TokenText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="14" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="Tokenni yangilash" Command="{Binding RotateTokenCommand}" Margin="0"
                                    IsEnabled="{Binding Busy, Converter={x:Static local:InverseBool.Instance}}"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding TelegramInfo}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="{Binding AccountId, StringFormat='Hisob ID: {0}'}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="{Binding BotLabel, StringFormat='Bot: {0}'}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Gemini -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="✗"/><Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding GeminiReady}" Value="True"><Setter Property="Text" Value="✓"/><Setter Property="Foreground" Value="#15803D"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel>
                            <TextBlock Text="Gemini" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding GeminiText}" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Jadval -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Ish vaqti (video tayyorlash)" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                                   Text="Worker har kuni shu oraliqda navbatdagi mavzular bo'yicha 1–3 ta video tayyorlaydi (boshlangan video oxirigacha tugatiladi). Har 10 daqiqada yengil tekshiruv botdagi «Hozir chiqarish» va buyruqlarni oladi. Jadvalni botda ham o'zgartirish mumkin."/>
                        <CheckBox Content="Har kuni avtomatik ishlash" IsChecked="{Binding ScheduleEnabled}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Boshlanish" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <TextBlock Text="Tugash" VerticalAlignment="Center" Margin="16,0,6,0"/>
                            <TextBox Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <TextBlock Text="Vaqt zonasi" VerticalAlignment="Center" Margin="16,0,6,0"/>
                            <TextBox Text="{Binding TimeZoneId, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                            <Button Content="Saqlash" Style="{StaticResource Primary}" Command="{Binding SaveScheduleCommand}" Margin="16,0,0,0"
                                    IsEnabled="{Binding Busy, Converter={x:Static local:InverseBool.Instance}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ScheduleInfo}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Dasturlar -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Claude'ga kirish" Command="{Binding ClaudeLoginCommand}"/>
                                <Button Content="Yetishmaganlarini o'rnatish" Command="{Binding InstallMissingCommand}" Margin="0"
                                        Visibility="{Binding ToolsMissing, Converter={x:Static local:BoolToVis.Instance}}"
                                        IsEnabled="{Binding Busy, Converter={x:Static local:InverseBool.Instance}}"/>
                            </StackPanel>
                            <TextBlock Text="Kerakli dasturlar" Style="{StaticResource H2}" Margin="0"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Tools}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Left" Width="22" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="✗"/><Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding Ok}" Value="True"><Setter Property="Text" Value="✓"/><Setter Property="Foreground" Value="#15803D"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" Width="260"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding InstallText}" Style="{StaticResource Muted}" Margin="0,6,0,0"
                                   Visibility="{Binding InstallText, Converter={x:Static local:NullToCollapsedConverter.Instance}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
